<div class="page-head">
  <h2>Inbox</h2>
  <p class="muted">Customers who’ve messaged your pages, and conversations that need a human.</p>
</div>

<div class="tabs">
  <a href="/profiles/inbox" class="active">Conversations</a>
  <a href="/orders/tickets">Needs a human</a>
</div>

<div class="card" style="margin-bottom: 1.5rem;">
  <h3 style="margin-top:0;">Load history from Facebook</h3>
  <% if @connected_pages.any? %>
    <p class="muted" style="font-size:0.9rem;">Pull past conversation threads for a connected page.</p>
    <%= form_with url: profiles_inbox_path, method: :get, local: true, style: "display:flex; gap:0.5rem; align-items:center;" do |f| %>
      <select name="page_id" required style="padding:0.6rem; border-radius:4px; border:1px solid var(--border-color); background:#0f172a; color:white; flex-grow:1;">
        <option value="">Select a page…</option>
        <% @connected_pages.each do |page| %>
          <option value="<%= page.page_id %>" <%= 'selected' if params[:page_id] == page.page_id %>><%= page.name %></option>
        <% end %>
      </select>
      <button type="submit" class="btn">Load history</button>
    <% end %>

    <% if @conversations_response.present? %>
      <% threads = @conversations_response["data"] || [] %>
      <div style="margin-top:1.5rem;">
        <% if threads.any? %>
          <% threads.each do |thread| %>
            <% msgs = thread.dig("messages", "data") || [] %>
            <div style="border:1px solid var(--border-color); border-radius:8px; padding:1rem; margin-bottom:0.75rem; background:rgba(0,0,0,0.2);">
              <div class="muted" style="font-size:0.8rem; margin-bottom:0.5rem;">
                Updated <%= thread["updated_time"] %> · <%= msgs.size %> message<%= 's' unless msgs.size == 1 %>
              </div>
              <% msgs.first(5).each do |m| %>
                <div style="margin-bottom:0.35rem;">
                  <strong style="font-size:0.85rem;"><%= m.dig("from", "name") || "Customer" %>:</strong>
                  <span style="font-size:0.9rem;"><%= m["message"].presence || "(no text)" %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <p class="muted">No conversation history returned for this page yet.</p>
        <% end %>

        <% if Rails.env.development? %>
          <details class="dev-note">
            <summary>Developer: raw Conversations API response</summary>
            <pre style="font-size:0.8rem; color:#38bdf8; max-height:300px; overflow:auto;"><%= JSON.pretty_generate(@conversations_response) %></pre>
          </details>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty">
      <div class="icon">🔌</div>
      <p>Connect a page first to load history. <a href="/onboarding/connect" style="color:var(--primary-color);">Go to Connections →</a></p>
    </div>
  <% end %>
</div>

<div class="card">
  <h3 style="margin-top:0;">Customers</h3>
  <% if @profiles.any? %>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <% @profiles.each do |profile| %>
        <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px; background: rgba(0,0,0,0.2);">
          <% if profile.profile_pic.present? %>
            <img src="<%= profile.profile_pic %>" alt="<%= profile.full_name %>" style="width: 54px; height: 54px; border-radius: 50%; object-fit: cover;">
          <% else %>
            <div style="width: 54px; height: 54px; border-radius: 50%; background: #3b82f6; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem;">
              <%= profile.first_name&.first || "U" %>
            </div>
          <% end %>
          <div style="flex-grow: 1;">
            <div style="font-weight: bold; font-size: 1.1rem;"><%= profile.full_name %></div>
            <div class="muted" style="font-size: 0.85rem;">
              <%= profile.locale || 'en_US' %>
              <% if Rails.env.development? %> · <code><%= profile.psid %></code><% end %>
            </div>
          </div>
          <span class="badge badge-green">Verified</span>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <div class="icon">💬</div>
      <p>No customers yet. When someone messages your page, they’ll appear here.</p>
    </div>
  <% end %>
</div>

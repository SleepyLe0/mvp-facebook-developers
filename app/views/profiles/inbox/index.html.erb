<div class="page-head">
  <h2>Inbox</h2>
  <p class="muted">All conversations from your pages in one place. Reply normally within 24h, or use the Human Agent tag for older messages.</p>
</div>

<% if @page.nil? %>
  <div class="card">
    <div class="empty">
      <div class="icon">🔌</div>
      <p>Connect a page to start chatting with customers. <a href="/onboarding/connect" style="color:var(--primary-color);">Go to Connections →</a></p>
    </div>
  </div>
<% else %>
  <div style="display:grid; grid-template-columns: 320px 1fr; gap:1rem; align-items:start;">

    <!-- Conversation list -->
    <div class="card" id="chat-list"
         data-url="<%= profiles_inbox_poll_path %>"
         data-psid="<%= @active_psid %>"
         style="padding:0.5rem; max-height:74vh; overflow-y:auto;">
      <% if @conversations.any? %>
        <% @conversations.each do |c| %>
          <% active = (@active_psid == c[:psid]) %>
          <% flag = (t = @tickets_by_psid[c[:psid]]) ? (t.handled_by_human ? "handling" : "needs_human") : nil %>
          <a href="<%= profiles_inbox_path(psid: c[:psid]) %>"
             style="display:flex; align-items:center; gap:0.75rem; padding:0.6rem 0.75rem; border-radius:8px; text-decoration:none; color:var(--text-main); <%= 'background:rgba(59,130,246,0.15);' if active %>">
            <div style="width:40px; height:40px; border-radius:50%; background:#3b82f6; display:flex; align-items:center; justify-content:center; font-weight:bold; flex-shrink:0;"><%= c[:name].to_s.first || "U" %></div>
            <div style="min-width:0; flex:1;">
              <div style="font-weight:600; font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c[:name] %></div>
              <div class="muted" style="font-size:0.75rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c[:snippet].presence || "…" %></div>
            </div>
            <% if flag == "needs_human" %>
              <span class="badge badge-orange" style="font-size:0.65rem; flex-shrink:0;">Needs reply</span>
            <% elsif flag == "handling" %>
              <span class="badge badge-green" style="font-size:0.65rem; flex-shrink:0;">Handling</span>
            <% end %>
          </a>
        <% end %>
      <% else %>
        <div class="empty" style="padding:1.5rem 1rem;"><div class="icon">💬</div><p style="font-size:0.9rem;">No conversations yet.</p></div>
      <% end %>
    </div>

    <!-- Chat pane -->
    <div class="card" style="display:flex; flex-direction:column; height:74vh; padding:0;">
      <% if @active_psid %>
        <!-- Header -->
        <div style="padding:1rem 1.25rem; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center; gap:0.5rem;">
          <strong style="font-size:1.05rem;"><%= @active_name %></strong>
          <div style="display:flex; gap:0.5rem; align-items:center;">
            <% if @active_ticket&.handled_by_human %>
              <span class="badge badge-green">🙋 You’re handling · bot paused</span>
              <%= button_to "▶ Resume bot", profiles_inbox_toggle_bot_path(psid: @active_psid), method: :post, class: "btn btn-secondary", style: "font-size:0.8rem; padding:0.35rem 0.7rem;" %>
            <% else %>
              <% if @active_ticket %><span class="badge badge-orange">Needs a human</span><% end %>
              <%= button_to "🙋 Take over", profiles_inbox_toggle_bot_path(psid: @active_psid), method: :post, class: "btn btn-secondary", style: "font-size:0.8rem; padding:0.35rem 0.7rem;" %>
            <% end %>
          </div>
        </div>

        <!-- Messages -->
        <div id="chat-messages" style="flex:1; overflow-y:auto; padding:1.25rem; display:flex; flex-direction:column; gap:0.6rem;">
          <% if @thread.blank? %>
            <div class="empty" style="margin:auto;"><div class="icon">👋</div><p>No messages loaded yet. Say hello below.</p></div>
          <% else %>
            <% @thread.each do |m| %>
              <% outgoing = m.dig("from", "id").to_s == @page.page_id.to_s %>
              <div style="max-width:70%; align-self:<%= outgoing ? 'flex-end' : 'flex-start' %>;">
                <div style="padding:0.6rem 0.9rem; border-radius:14px; font-size:0.95rem; background:<%= outgoing ? 'var(--primary-color)' : '#334155' %>; color:white;">
                  <%= m["message"].presence || "(no text)" %>
                </div>
                <div class="muted" style="font-size:0.7rem; margin-top:0.2rem; text-align:<%= outgoing ? 'right' : 'left' %>;">
                  <%= m.dig("from", "name") || (outgoing ? "You" : "Customer") %> · <%= format_chat_time(m["created_time"]) %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- Composer at the foot -->
        <% if @within_window %>
          <!-- Within 24h: normal Messenger reply -->
          <%= form_with url: profiles_inbox_reply_path, method: :post, local: true, id: "composer", style: "border-top:1px solid var(--border-color); padding:0.75rem;" do %>
            <input type="hidden" name="psid" value="<%= @active_psid %>">
            <div style="display:flex; gap:0.5rem; align-items:center;">
              <input type="text" name="body" placeholder="Type a message…" autocomplete="off" autofocus
                     style="flex:1 1 auto; min-width:0; padding:0.85rem 1rem; font-size:1rem; border-radius:8px; border:1px solid var(--border-color); background:#0f172a; color:white; box-sizing:border-box;">
              <button type="submit" class="btn" style="flex:0 0 auto;">Send</button>
            </div>
          <% end %>
        <% elsif !@within_7d %>
          <!-- Outside 7 days: nothing can be sent until the customer messages again -->
          <div style="border-top:1px solid var(--border-color); padding:1.1rem 0.75rem; text-align:center;">
            <span class="muted" style="font-size:0.85rem;">💤 This conversation is closed — it’s been more than 7 days since the customer’s last message. You can’t send a message until they message you again.</span>
          </div>
        <% else %>
          <!-- 24h–7d: standard replies disabled — Human Agent tag only -->
          <div style="border-top:1px solid var(--border-color); padding:0.75rem;">
            <div style="font-size:0.85rem; color:#fb923c; margin-bottom:0.6rem;">
              ⏳ This conversation is outside the 24-hour window — standard replies can’t be sent. You can reply using the Human Agent tag (allowed for up to 7 days).
            </div>
            <%= form_with url: profiles_inbox_reply_path, method: :post, local: true, id: "composer", html: { "data-ha-form": true } do %>
              <input type="hidden" name="psid" value="<%= @active_psid %>">
              <input type="hidden" name="human_agent" value="1">
              <input type="hidden" name="human_confirmation" value="">
              <div style="display:flex; gap:0.5rem; align-items:center;">
                <input type="text" name="body" placeholder="Locked — unlock the Human Agent tag to type" autocomplete="off" disabled data-locked
                       style="flex:1 1 auto; min-width:0; padding:0.85rem 1rem; font-size:1rem; border-radius:8px; border:1px solid var(--border-color); background:#0f172a; color:white; box-sizing:border-box;">
                <button type="button" class="btn" style="flex:0 0 auto; background:#f97316; color:white;" data-ha-open>🔒 Use Human Agent tag…</button>
                <button type="submit" class="btn" style="flex:0 0 auto; background:#f97316; color:white; display:none;" data-ha-submit>Send →</button>
              </div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="empty" style="margin:auto;">
          <div class="icon">💬</div>
          <p>Select a conversation to open it.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Human Agent warning dialog -->
  <dialog id="ha-warning" style="max-width:460px; border:1px solid var(--border-color); border-radius:10px; background:var(--card-bg); color:var(--text-main); padding:1.5rem;">
    <h3 style="margin:0 0 0.8rem; color:#fb923c;">Warning !!!</h3>
    <p style="font-size:0.9rem; margin:0 0 1rem;">
      You can respond to user inquiries within 7 days after a user message. You should only use this for issues
      that cannot be resolved within the 24 hours window (e.g. business is closed for the weekend, issue requires
      &gt;24 hours to resolve). <strong>Your Facebook page could be blocked if you send a message for another purpose.</strong>
      Do not continue if you are not sure.
    </p>
    <div style="display:flex; justify-content:flex-end; gap:0.5rem;">
      <button type="button" class="btn btn-secondary" data-ha-cancel>Cancel</button>
      <button type="button" class="btn" style="background:#f97316;" data-ha-agree>I understand, Continue</button>
    </div>
  </dialog>

  <script>
    (function () {
      // ---- Human Agent gated composer (outside-window only) ----
      var form = document.getElementById("composer");
      var dlg = document.getElementById("ha-warning");
      if (form && dlg && form.querySelector("[data-ha-open]")) {
        var haBtn = form.querySelector("[data-ha-open]");
        haBtn.addEventListener("click", function () { dlg.showModal(); });
        dlg.querySelector("[data-ha-cancel]").addEventListener("click", function () { dlg.close(); });
        dlg.querySelector("[data-ha-agree]").addEventListener("click", function () {
          dlg.close();
          form.querySelector("[name=human_confirmation]").value = "1";
          var body = form.querySelector("[name=body]");
          body.disabled = false;
          body.placeholder = "Type a personal reply to the customer…";
          body.focus();
          haBtn.style.display = "none";
          var submitBtn = form.querySelector("[data-ha-submit]");
          if (submitBtn) submitBtn.style.display = "";
        });
      }

      // ---- Live polling: refresh conversation list + open thread ----
      var list = document.getElementById("chat-list");
      if (!list) return;
      var box = document.getElementById("chat-messages");
      var url = list.dataset.url, psid = list.dataset.psid || "", listSig = "", msgCount = -1;

      function esc(s) { var d = document.createElement("div"); d.textContent = (s == null ? "" : s); return d.innerHTML; }

      function badge(flag) {
        if (flag === "needs_human") return '<span class="badge badge-orange" style="font-size:0.65rem;flex-shrink:0;">Needs reply</span>';
        if (flag === "handling") return '<span class="badge badge-green" style="font-size:0.65rem;flex-shrink:0;">Handling</span>';
        return "";
      }

      function renderList(convs) {
        list.innerHTML = convs.map(function (c) {
          var bg = (c.psid === psid) ? "background:rgba(59,130,246,0.15);" : "";
          return '<a href="/profiles/inbox?psid=' + encodeURIComponent(c.psid) + '" style="display:flex;align-items:center;gap:0.75rem;padding:0.6rem 0.75rem;border-radius:8px;text-decoration:none;color:var(--text-main);' + bg + '">' +
                   '<div style="width:40px;height:40px;border-radius:50%;background:#3b82f6;display:flex;align-items:center;justify-content:center;font-weight:bold;flex-shrink:0;">' + esc((c.name || "U").charAt(0)) + '</div>' +
                   '<div style="min-width:0;flex:1;">' +
                     '<div style="font-weight:600;font-size:0.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(c.name) + '</div>' +
                     '<div class="muted" style="font-size:0.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + esc(c.snippet || "…") + '</div>' +
                   '</div>' + badge(c.flag) +
                 '</a>';
        }).join("");
      }

      function renderMessages(msgs) {
        box.innerHTML = msgs.map(function (m) {
          var side = m.outgoing ? "flex-end" : "flex-start";
          var bg = m.outgoing ? "var(--primary-color)" : "#334155";
          return '<div style="max-width:70%;align-self:' + side + ';">' +
                   '<div style="padding:0.6rem 0.9rem;border-radius:14px;font-size:0.95rem;background:' + bg + ';color:white;">' + esc(m.text) + '</div>' +
                   '<div class="muted" style="font-size:0.7rem;margin-top:0.2rem;text-align:' + (m.outgoing ? "right" : "left") + ';">' + esc(m.name) + ' · ' + esc(m.time) + '</div>' +
                 '</div>';
        }).join("");
        box.scrollTop = box.scrollHeight;
      }

      function poll() {
        fetch(url + (psid ? "?psid=" + encodeURIComponent(psid) : ""), { headers: { "Accept": "application/json" } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var convs = d.conversations || [], sig = JSON.stringify(convs);
            if (sig !== listSig) { listSig = sig; renderList(convs); }
            if (box) {
              var m = d.messages || [];
              if (m.length !== msgCount) { msgCount = m.length; renderMessages(m); }
            }
          })
          .catch(function () {});
      }

      if (box) box.scrollTop = box.scrollHeight;
      poll();
      setInterval(poll, 4000);
    })();
  </script>
<% end %>

<div class="page-head">
  <h2>Inbox</h2>
  <p class="muted">Chat with customers who’ve messaged your pages, and handle conversations that need a human.</p>
</div>

<div class="tabs">
  <a href="/profiles/inbox" class="active">Conversations</a>
  <a href="/orders/tickets">Needs a human</a>
</div>

<% if @page.nil? %>
  <div class="card">
    <div class="empty">
      <div class="icon">🔌</div>
      <p>Connect a page to start chatting with customers. <a href="/onboarding/connect" style="color:var(--primary-color);">Go to Connections →</a></p>
    </div>
  </div>
<% else %>
  <div style="display:grid; grid-template-columns: 300px 1fr; gap:1rem; align-items:start;">

    <!-- Customer list -->
    <div class="card" style="padding:0.5rem; max-height:70vh; overflow-y:auto;">
      <% if @conversations.any? %>
        <% @conversations.each do |c| %>
          <% active = (@active_psid == c[:psid]) %>
          <a href="<%= profiles_inbox_path(psid: c[:psid]) %>"
             style="display:flex; align-items:center; gap:0.75rem; padding:0.6rem 0.75rem; border-radius:8px; text-decoration:none; color:var(--text-main); <%= 'background:rgba(59,130,246,0.15);' if active %>">
            <div style="width:40px; height:40px; border-radius:50%; background:#3b82f6; display:flex; align-items:center; justify-content:center; font-weight:bold; flex-shrink:0;"><%= c[:name].to_s.first || "U" %></div>
            <div style="min-width:0;">
              <div style="font-weight:600; font-size:0.95rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c[:name] %></div>
              <div class="muted" style="font-size:0.75rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= c[:snippet].presence || "…" %></div>
            </div>
          </a>
        <% end %>
      <% else %>
        <div class="empty" style="padding:1.5rem 1rem;"><div class="icon">💬</div><p style="font-size:0.9rem;">No conversations yet.</p></div>
      <% end %>
    </div>

    <!-- Chat pane -->
    <div class="card" style="display:flex; flex-direction:column; height:70vh; padding:0;">
      <% if @active_psid %>
        <!-- Header -->
        <div style="padding:1rem 1.25rem; border-bottom:1px solid var(--border-color);">
          <strong style="font-size:1.05rem;"><%= @active_name || "Customer" %></strong>
        </div>

        <!-- Messages -->
        <div style="flex:1; overflow-y:auto; padding:1.25rem; display:flex; flex-direction:column; gap:0.6rem;">
          <% if @thread.blank? %>
            <div class="empty" style="margin:auto;"><div class="icon">👋</div><p>No messages loaded yet. Say hello below.</p></div>
          <% else %>
            <% @thread.each do |m| %>
              <% outgoing = m.dig("from", "id").to_s == @page.page_id.to_s %>
              <div style="max-width:70%; align-self:<%= outgoing ? 'flex-end' : 'flex-start' %>;">
                <div style="padding:0.6rem 0.9rem; border-radius:14px; font-size:0.95rem;
                            background:<%= outgoing ? 'var(--primary-color)' : '#334155' %>; color:white;
                            border-<%= outgoing ? 'bottom-right' : 'bottom-left' %>-radius:4px;">
                  <%= m["message"].presence || "(no text)" %>
                </div>
                <div class="muted" style="font-size:0.7rem; margin-top:0.2rem; text-align:<%= outgoing ? 'right' : 'left' %>;">
                  <%= m.dig("from", "name") || (outgoing ? "You" : "Customer") %> · <%= m["created_time"] %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- Reply box -->
        <%= form_with url: profiles_inbox_reply_path, method: :post, local: true, style: "border-top:1px solid var(--border-color); padding:0.75rem; display:flex; gap:0.5rem;" do %>
          <input type="hidden" name="psid" value="<%= @active_psid %>">
          <input type="text" name="body" placeholder="Type a message…" autocomplete="off" autofocus
                 style="flex:1; padding:0.7rem 0.9rem; border-radius:8px; border:1px solid var(--border-color); background:#0f172a; color:white;">
          <button type="submit" class="btn">Send</button>
        <% end %>
      <% else %>
        <div class="empty" style="margin:auto;">
          <div class="icon">💬</div>
          <p>Select a customer to open the conversation.</p>
        </div>
      <% end %>
    </div>
  </div>

  <p class="muted" style="font-size:0.8rem; margin-top:0.75rem;">
    Replies send instantly via Messenger. Meta only allows standard replies within 24 hours of the customer’s last message — after that, use <a href="/orders/tickets" style="color:var(--primary-color);">Needs a human</a>.
  </p>
<% end %>

<div class="page-head">
  <h2>Inbox</h2>
  <p class="muted">Customers who’ve messaged your pages, and conversations that need a human.</p>
</div>

<div class="tabs">
  <a href="/profiles/inbox">Conversations</a>
  <a href="/orders/tickets" class="active">Needs a human</a>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h3 style="margin:0;">Escalated conversations</h3>
    <span class="muted" style="font-size:0.85rem;">🔒 Human verification required to reply</span>
  </div>
  <% if @tickets.any? %>
    <div style="display:flex; flex-direction:column; gap:1.5rem; margin-top:1rem;">
      <% @tickets.each do |ticket| %>
        <div style="border:1px solid var(--border-color); border-radius:8px; padding:1.5rem; background:rgba(0,0,0,0.2);">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <div>
              <strong style="font-size:1.1rem;">Conversation #<%= ticket.id %></strong>
              <% if Rails.env.development? %>
                <span class="muted" style="font-size:0.85rem; margin-left:0.5rem;">Customer PSID: <code><%= ticket.psid %></code></span>
              <% end %>
            </div>
            <div style="display:flex; gap:0.5rem; align-items:center;">
              <% if ticket.handled_by_human %>
                <span class="badge badge-green">🙋 You’re handling · bot paused</span>
              <% end %>
              <span class="badge <%= ticket.status == 'open' ? 'badge-orange' : 'badge-green' %>">
                <%= ticket.status.to_s.titleize %>
              </span>
              <%= button_to (ticket.handled_by_human ? "Resume bot" : "Take over"), orders_toggle_bot_ticket_path(ticket), method: :post, class: "btn btn-secondary", style: "font-size:0.8rem; padding:0.3rem 0.7rem;" %>
            </div>
          </div>

          <% thread = @threads[ticket.psid] %>
          <div style="background:#0f172a; padding:1rem; border-radius:8px; margin-bottom:1rem; max-height:280px; overflow-y:auto; display:flex; flex-direction:column; gap:0.5rem;">
            <% if thread.present? %>
              <% thread.each do |m| %>
                <% outgoing = m.dig("from", "id").to_s == @page&.page_id.to_s %>
                <div style="max-width:75%; align-self:<%= outgoing ? 'flex-end' : 'flex-start' %>;">
                  <div style="padding:0.5rem 0.8rem; border-radius:12px; font-size:0.9rem; background:<%= outgoing ? 'var(--primary-color)' : '#334155' %>; color:white;">
                    <%= m["message"].presence || "(no text)" %>
                  </div>
                  <div class="muted" style="font-size:0.68rem; margin-top:0.15rem; text-align:<%= outgoing ? 'right' : 'left' %>;">
                    <%= m.dig("from", "name") || (outgoing ? "You" : "Customer") %> · <%= format_chat_time(m["created_time"]) %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="muted" style="font-size:0.8rem; font-weight:bold;">LATEST MESSAGE</div>
              <div style="font-size:1rem; color:white;">"<%= ticket.last_message %>"</div>
              <div class="muted" style="font-size:0.75rem;">Received <%= ticket.created_at.strftime("%b %-d, %H:%M") %></div>
            <% end %>
          </div>


          <% if ticket.human_agent_window_open? %>
          <%= form_with url: orders_reply_ticket_path(ticket), method: :post, local: true, data: { ha: true } do |f| %>
            <input type="hidden" name="human_confirmation" value="">
            <div style="background:rgba(255,255,255,0.03); padding:1rem; border-radius:6px; border:1px dashed var(--border-color);">
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.8rem;">
                <h4 style="margin:0; color:var(--primary-color);">Reply as a human agent</h4>
                <span class="badge badge-orange" data-lockbadge>🔒 Locked</span>
              </div>

              <div style="display:grid; grid-template-columns: 1fr 2fr; gap:1rem; margin-bottom:1rem;">
                <div>
                  <label style="display:block; font-size:0.85rem; font-weight:bold; margin-bottom:0.3rem;">Category</label>
                  <select name="category" required disabled data-locked style="width:100%; padding:0.5rem; border-radius:4px; border:1px solid var(--border-color); background:#0f172a; color:white;">
                    <option value="Order Issue">📦 Order Issue / Damage</option>
                    <option value="Product Support">🛠 Product Support</option>
                    <option value="Billing Inquiry">💳 Billing &amp; Refunds</option>
                    <option value="General Support">💬 General Support</option>
                  </select>
                </div>

                <div>
                  <label style="display:block; font-size:0.85rem; font-weight:bold; margin-bottom:0.3rem;">Your reply</label>
                  <input type="text" name="reply_text" placeholder="Locked — unlock the Human Agent tag to type" required disabled data-locked style="width:100%; padding:0.5rem; border-radius:4px; border:1px solid var(--border-color); background:#0f172a; color:white; box-sizing:border-box;">
                </div>
              </div>

              <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem;">
                <span class="muted" style="font-size:0.8rem;" data-lockhint>The message can not be sent outside the allowed window.</span>
                <button type="button" class="btn btn-secondary" data-unlock>🔒 Use Human Agent tag…</button>
                <button type="submit" class="btn" disabled data-locked style="background:#f97316; display:none;">Send reply →</button>
              </div>
            </div>
          <% end %>
          <% else %>
            <div style="background:rgba(249,115,22,0.08); border:1px solid var(--border-color); border-radius:6px; padding:1rem; color:var(--text-muted); font-size:0.9rem;">
              ⏳ The 7-day Human Agent window has expired. You can reply again once the customer sends a new message.
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <div class="icon">✅</div>
      <p>Nothing needs a human right now. When Army KlangTECH can’t auto-answer a customer, it’ll show up here.</p>
    </div>
  <% end %>
</div>

<dialog id="ha-warning" style="max-width:460px; border:1px solid var(--border-color); border-radius:10px; background:var(--card-bg); color:var(--text-main); padding:1.5rem;">
  <h3 style="margin:0 0 0.8rem; color:#fb923c;">Warning !!!</h3>
  <p style="font-size:0.9rem; margin:0 0 1rem;">
    You can respond to user inquiries within 7 days after a user message. You should only use this for issues
    that cannot be resolved within the 24 hours window (e.g. business is closed for the weekend, issue requires
    &gt;24 hours to resolve). <strong>Your Facebook page could be blocked if you send a message for other purpose.</strong>
    Do not continue if you are not sure.
  </p>
  <div style="display:flex; justify-content:flex-end; gap:0.5rem;">
    <button type="button" class="btn btn-secondary" data-ha-cancel>Cancel</button>
    <button type="button" class="btn" data-ha-agree>I understand, Continue</button>
  </div>
</dialog>

<script>
  // Human Agent tag is deliberately hard to reach: locked composer → warning → one message → re-locked.
  (function () {
    const dlg = document.getElementById("ha-warning");
    let pending = null;

    document.querySelectorAll("[data-unlock]").forEach(function (btn) {
      btn.addEventListener("click", function () { pending = btn.closest("form"); dlg.showModal(); });
    });

    dlg.querySelector("[data-ha-cancel]").addEventListener("click", function () { pending = null; dlg.close(); });

    dlg.querySelector("[data-ha-agree]").addEventListener("click", function () {
      dlg.close();
      if (!pending) return;
      const form = pending;
      pending = null;
      form.querySelectorAll("[data-locked]").forEach(function (el) { el.disabled = false; });
      form.querySelector("[name=human_confirmation]").value = "1";
      form.querySelector("[data-unlock]").style.display = "none";
      form.querySelector("button[type=submit]").style.display = "";
      form.querySelector("[data-lockbadge]").textContent = "🔓 Unlocked for one message";
      form.querySelector("[data-lockhint]").textContent = "This unlock expires as soon as you send.";
      const input = form.querySelector("[name=reply_text]");
      input.placeholder = "Type a personal reply to the customer…";
      input.focus();
    });

    document.querySelectorAll("form[data-ha]").forEach(function (form) {
      form.addEventListener("submit", function () {
        // Re-lock after the browser has serialised the form, so the fields still submit.
        setTimeout(function () {
          form.querySelectorAll("[data-locked]").forEach(function (el) { el.disabled = true; });
          form.querySelector("[name=human_confirmation]").value = "";
          form.querySelector("[data-lockbadge]").textContent = "🔒 Locked";
        }, 0);
      });
    });
  })();
</script>

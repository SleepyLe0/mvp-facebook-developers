<% connected = @connected_page_count.to_i > 0 %>

<div class="page-head">
  <h1>Welcome to ReplyDesk</h1>
  <p class="muted">Connect your Facebook &amp; Instagram pages, auto-answer common questions, and hand off tricky ones to a human.</p>
</div>

<% unless connected %>
  <!-- First-run: nothing connected yet -->
  <div class="card">
    <div class="hero">
      <div class="icon">🔌</div>
      <h2 style="margin:0 0 0.5rem;">Let’s get you set up</h2>
      <p class="muted" style="max-width:460px; margin:0 auto 1.5rem;">
        Connect a Facebook Page to start receiving messages. It takes about a minute — we’ll handle the webhook setup for you.
      </p>
      <a href="/onboarding/connect" class="btn" style="padding:0.8rem 1.6rem; font-size:1rem;">Connect your first page →</a>
    </div>
  </div>
<% else %>
  <!-- Connected: overview -->
  <div class="stats">
    <div class="stat"><div class="n"><%= @connected_page_count %></div><div class="l">Connected pages</div></div>
    <div class="stat"><div class="n"><%= @ticket_count %></div><div class="l">Support tickets</div></div>
    <div class="stat"><div class="n"><%= @profile_count %></div><div class="l">Customers seen</div></div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
    <div class="card">
      <h3 style="margin-top:0;">📥 Inbox</h3>
      <p class="muted" style="font-size:0.9rem;">See customer conversations and reply to anyone escalated to a human agent.</p>
      <a href="/profiles/inbox" class="btn" style="font-size:0.85rem;">Open Inbox →</a>
    </div>
    <div class="card">
      <h3 style="margin-top:0;">🔌 Connections</h3>
      <p class="muted" style="font-size:0.9rem;">Manage the Facebook Pages and Instagram accounts linked to ReplyDesk.</p>
      <a href="/onboarding/connect" class="btn btn-secondary" style="font-size:0.85rem;">Manage connections →</a>
    </div>
  </div>
<% end %>

<div class="card" style="margin-top: 1.5rem;">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <h3 style="margin:0;">Recent activity</h3>
    <a href="/webhook_logs" class="muted" style="font-size:0.85rem; text-decoration:none;">View all →</a>
  </div>
  <% if @recent_logs.any? %>
    <table>
      <thead>
        <tr><th>Time</th><th>Channel</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% @recent_logs.each do |log| %>
          <tr>
            <td><%= log.created_at.strftime("%b %-d, %H:%M") %></td>
            <td><%= log.event_type.to_s.titleize %></td>
            <td><span class="badge <%= log.status == 'completed' ? 'badge-green' : 'badge-orange' %>"><%= log.status.to_s.titleize %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty"><div class="icon">🕊️</div><p>No activity yet. Once a customer messages your page, it’ll show up here.</p></div>
  <% end %>
</div>

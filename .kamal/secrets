# Secrets are referenced from config/deploy.yml (registry/password, env/secret).
# This file is safe for git: it holds references/commands, not raw values.
# Values below are read from config/master.key and .env (both gitignored).

RAILS_MASTER_KEY=$(cat config/master.key)

# Docker Hub access token (create at hub.docker.com -> Account Settings -> Security).
# Export it in your shell before deploying:  export KAMAL_REGISTRY_PASSWORD=dckr_pat_xxx
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Facebook app secrets, pulled from .env
FB_APP_ID=$(grep -E '^FB_APP_ID=' .env | cut -d= -f2-)
FB_APP_SECRET=$(grep -E '^FB_APP_SECRET=' .env | cut -d= -f2-)
FB_VERIFY_TOKEN=$(grep -E '^FB_VERIFY_TOKEN=' .env | cut -d= -f2-)
FB_PAGE_ACCESS_TOKEN=$(grep -E '^FB_PAGE_ACCESS_TOKEN=' .env | cut -d= -f2-)
